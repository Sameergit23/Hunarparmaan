{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "PORT",
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_REGION",
    "LOCAL_OBJECT_DIR",
    "JWT_SECRET",
    "JWT_TTL_HOURS",
    "MOCK_INTEGRATIONS",
    "RESCORE_SAMPLE_RATE",
    "GEOFENCE_RADIUS_M",
    "CLOCK_DRIFT_LIMIT_S",
    "PUBLIC_API_URL",
    "PUBLIC_WEB_URL",
    "API_URL",
    "EXPO_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "env": ["TEST_DATABASE_URL"],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
