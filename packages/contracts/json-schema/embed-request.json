{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "texts": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "kind": {
      "type": "string",
      "enum": ["query", "passage"]
    }
  },
  "required": ["texts", "kind"],
  "additionalProperties": false
}
