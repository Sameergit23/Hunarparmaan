{
  "name": "hunarpramaan",
  "private": true,
  "description": "Offline-first, AI-assisted RPL assessment tool (SIH 2026)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "pack:build": "pnpm --filter @hunarpramaan/trade-packs run pack:build",
    "e2e:web": "pnpm --filter @hunarpramaan/web run e2e",
    "e2e:install": "pnpm --filter @hunarpramaan/web run e2e:install",
    "dev": "turbo run dev",
    "db:migrate": "pnpm --filter @hunarpramaan/api run db:migrate",
    "db:seed": "pnpm --filter @hunarpramaan/api run db:seed",
    "db:reset": "pnpm --filter @hunarpramaan/api run db:reset",
    "ai:dev": "uv run --directory services/ai --extra detector uvicorn hunarpramaan_ai.app:app --port 8000",
    "ai:test": "uv run --directory services/ai pytest",
    "ai:lint": "uv run --directory services/ai ruff check . ../../evaluation && uv run --directory services/ai ruff format --check . ../../evaluation",
    "ai:eval": "uv run --directory services/ai --extra detector python ../../evaluation/safety-gear/evaluate.py",
    "ai:clip": "uv run --directory services/ai python ../../evaluation/safety-gear/make_clip.py",
    "demo:vision": "pnpm --filter @hunarpramaan/api run demo:vision"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
