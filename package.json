{
  "name": "hunarpramaan",
  "private": true,
  "description": "Offline-first, AI-assisted RPL assessment tool (SIH 2026)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "pack:build": "pnpm --filter @hunarpramaan/trade-packs run pack:build",
    "e2e:web": "pnpm --filter @hunarpramaan/web run e2e",
    "dev": "turbo run dev",
    "db:migrate": "pnpm --filter @hunarpramaan/api run db:migrate",
    "db:seed": "pnpm --filter @hunarpramaan/api run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
