{
  "name": "@hunarpramaan/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "HunarPramaan phone app for workers, mobilisers and assessors (Expo, React Native). Works offline; previews in a browser",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8081",
    "start": "expo start",
    "android": "expo run:android",
    "build": "expo export --platform web --output-dir dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/hind": "^0.4.1",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@hunarpramaan/audit": "workspace:*",
    "@hunarpramaan/contracts": "workspace:*",
    "@hunarpramaan/scoring": "workspace:*",
    "expo": "~58.0.14",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-location": "~58.0.17",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "idb-keyval": "^6.3.0",
    "lucide-react-native": "^1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hunarpramaan/trade-packs": "workspace:*",
    "@types/react": "^19.1.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
