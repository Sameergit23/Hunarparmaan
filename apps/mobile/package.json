  "private": true,
  "description": "HunarPramaan Android app: the worker interview and the assessor's offline tools. Expo dev build (ADR 002)",
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "start": "expo start --dev-client",
