    "@hunarpramaan/scoring": "workspace:*",
    "@hunarpramaan/trade-packs": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-network": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "lucide-react-native": "^1.59.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
