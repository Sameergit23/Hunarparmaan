# Copy to .env (cp .env.example .env). Never commit .env.
# With nothing set, the API runs locally on PGlite (an in-process PostgreSQL),
# runs jobs itself and keeps clips on disk: no Docker needed.

# --- api: the Docker setup (docker compose -f infra/docker-compose.yml up -d) ---
# DATABASE_URL=postgres://hp:hp@localhost:5432/hunarpramaan
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:8333
# S3_BUCKET=evidence
# S3_ACCESS_KEY=local
# S3_SECRET_KEY=local

# --- api: always ---
# Required anywhere but a laptop: a long random string, e.g. from: openssl rand -base64 48
# Only when the API runs on localhost in development is a development-only key used instead.
JWT_SECRET=
# SIDH, Aadhaar eKYC, OTP and NQR are mocked (on by default outside production)
MOCK_INTEGRATIONS=true
RESCORE_SAMPLE_RATE=0.10
GEOFENCE_RADIUS_M=200
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# --- web (apps/web reads its own .env; API_URL defaults to this) ---
# API_URL=http://localhost:4000

# --- ai (services/ai, coming in Sprint 1) ---
# Any OpenAI-compatible endpoint, preferably hosted in India. Only transcripts are sent.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
SARVAM_API_KEY=
AI_SERVICE_URL=http://localhost:8000

# --- mobile ---
# Your laptop's LAN address, not localhost: the phone has to reach it
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
