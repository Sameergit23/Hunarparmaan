# Copy to .env: cp .env.example .env (macOS, Linux, PowerShell) or copy .env.example .env (cmd).
# Never commit .env.
# With nothing set, the API runs locally on PGlite (an in-process PostgreSQL),
# runs jobs itself and keeps clips on disk: no Docker needed.
# The API reads this file and services/api/.env (which wins). The web app reads
# only apps/web/.env. A new setting also goes in turbo.json (globalPassThroughEnv).

# --- api: the Docker setup (docker compose -f infra/docker-compose.yml up -d --wait) ---
# DATABASE_URL=postgres://hp:hp@localhost:5432/hunarpramaan
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:8333
# S3_BUCKET=evidence
# S3_ACCESS_KEY=local
# S3_SECRET_KEY=local
# S3_REGION=us-east-1

# --- api: always ---
# A long random string, for example from
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
# It may stay empty only in development with PUBLIC_API_URL on localhost, 127.0.0.1 or [::1]:
# then a development-only key is used. Set it when PUBLIC_API_URL is a LAN address.
JWT_SECRET=
# JWT_TTL_HOURS=12
# SIDH, Aadhaar eKYC, OTP and NQR are mocked (on by default outside production)
MOCK_INTEGRATIONS=true
# Limits on sign-in codes and the lockout after 5 wrong PINs. On by default except in development
# SIGN_IN_LIMITS=true
RESCORE_SAMPLE_RATE=0.10
GEOFENCE_RADIUS_M=200
# Device time this far from server time raises a clock-drift flag
# CLOCK_DRIFT_LIMIT_S=300
# PORT=4000
# Where phones upload clips when there is no S3 store
PUBLIC_API_URL=http://localhost:4000
# Clips on disk when there is no S3 store (relative to services/api)
# LOCAL_OBJECT_DIR=./.data/objects
# Planned (Sprint 4): the QR target printed on certificates
PUBLIC_WEB_URL=http://localhost:3000

# --- web: put these in apps/web/.env, not here ---
# API_URL=http://localhost:4000

# --- tests and tooling (set in your shell, not in .env) ---
# TEST_DATABASE_URL=postgres://hp:hp@localhost:5432/hp_test   API tests on PostgreSQL; the name must contain "test"
# PLAYWRIGHT_CHROMIUM_PATH=                                    a Chromium you already have, instead of pnpm e2e:install
# E2E_BASE_URL=http://localhost:3000                           where pnpm e2e:web points
# HP_POSTGRES_PORT=5432  HP_REDIS_PORT=6379  HP_S3_PORT=8333   Docker host ports

# --- ai (services/ai, planned) ---
# Any OpenAI-compatible endpoint, preferably hosted in India. Only transcripts are sent.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
SARVAM_API_KEY=
AI_SERVICE_URL=http://localhost:8000

# --- mobile (apps/mobile, planned) ---
# Your laptop's LAN address, not localhost: the phone has to reach it
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
