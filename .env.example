# Copy to .env and fill in what you have. Never commit .env.
# Everything not set here has a local default (README "Configuration").

# --- api ---
DATABASE_URL=postgres://hp:hp@localhost:5432/hunarpramaan
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=
# A long random string, e.g. from: openssl rand -base64 48
JWT_SECRET=
AI_SERVICE_URL=http://localhost:8000
# SIDH, Aadhaar eKYC, OTP and NQR are mocked in the prototype
MOCK_INTEGRATIONS=true
ROUTING_THRESHOLD=0.70
RESCORE_SAMPLE_RATE=0.10
GEOFENCE_RADIUS_M=200

# --- ai ---
# Any OpenAI-compatible endpoint, preferably hosted in India. Only transcripts are sent.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
SARVAM_API_KEY=

# --- mobile ---
# Your laptop's LAN address, not localhost: the phone has to reach it
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
