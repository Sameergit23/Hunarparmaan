# Keep LF line endings in the working tree on every OS. Prettier checks for LF,
# so CRLF checkouts on Windows (core.autocrlf=true) would fail `pnpm lint`.
* text=auto eol=lf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.tar binary
*.tflite binary
*.onnx binary

# RFC 8785 test vectors are compared byte for byte.
packages/audit/test-vectors/** -text
