# Dependencies
node_modules/
.pnpm-store/

# Environment and secrets
.env
.env.*
!.env.example
*.pem

# Builds and caches
dist/
build/
.next/
.turbo/
coverage/
*.tsbuildinfo

# Expo / React Native (native folders are generated by prebuild)
.expo/
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Models are downloaded by a script, not committed
apps/mobile/assets/model-*/
*.tflite
*.onnx

# Recordings and personal data never go in Git
evaluation/**/raw/
*.mp4
*.mov
*.wav
*.m4a

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local API data (PGlite database and uploaded clips)
.data/
